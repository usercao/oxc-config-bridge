{
  "name": "oxc-config-bridge",
  "version": "0.1.2",
  "description": "Bridge one type-safe config to the native Oxlint and Oxfmt configuration formats",
  "keywords": [
    "oxc",
    "oxfmt",
    "oxlint",
    "config",
    "formatter",
    "linter"
  ],
  "homepage": "https://github.com/usercao/oxc-config-bridge#readme",
  "bugs": {
    "url": "https://github.com/usercao/oxc-config-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usercao/oxc-config-bridge.git"
  },
  "license": "MIT",
  "author": "usercao",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "oxc-config-bridge": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm test && npm pack --dry-run",
    "clean:editor": "node dist/cli.js clean --output-dir .",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "prepare:editor": "node dist/cli.js prepare --output-dir .",
    "test": "tsc -p tsconfig.json && tsc -p tsconfig.test.json --noEmit && vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "typescript": "~6.0.2",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "oxfmt": ">=0.50.0",
    "oxlint": ">=1.50.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "npm@11.17.0"
}
