{
  "name": "vite-oxc-bridge",
  "version": "0.6.2",
  "description": "Use Oxc's Vite+ config discovery with Vite, without Vite+",
  "keywords": [
    "oxc",
    "oxfmt",
    "oxlint",
    "config",
    "formatter",
    "linter",
    "vite",
    "vite-plus"
  ],
  "homepage": "https://github.com/usercao/vite-oxc-bridge#readme",
  "bugs": {
    "url": "https://github.com/usercao/vite-oxc-bridge/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usercao/vite-oxc-bridge.git"
  },
  "license": "MIT",
  "author": "usercao",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "vite-oxc-bridge": "dist/cli.js",
    "oxfmt": "bin/oxfmt.js",
    "oxlint": "bin/oxlint.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "check": "npm test && npm pack --dry-run",
    "prepack": "npm run build",
    "prepublishOnly": "npm test",
    "test": "tsc -p tsconfig.json && tsc -p tsconfig.test.json --noEmit && vitest run"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "~6.0.2",
    "vite": "7.3.6",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "vite": ">=5.0.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "npm@11.17.0"
}
